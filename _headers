# Cloudflare Pages security headers.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), payment=(), geolocation=(self)
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  # STEP 1: report-only (nothing is blocked; violations show in the browser console). Test every feature first.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://www.gstatic.com https://apis.google.com https://www.google.com/recaptcha/ https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://res.cloudinary.com https://*.googleusercontent.com; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://api.cloudinary.com https://www.google.com https://*.workers.dev; frame-src https://*.firebaseapp.com https://accounts.google.com https://apis.google.com https://www.google.com https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  # STEP 2: when the console shows no violations, delete the line above and un-comment this one (remove the leading #):
  # Content-Security-Policy: default-src 'self'; script-src 'self' https://www.gstatic.com https://apis.google.com https://www.google.com/recaptcha/ https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://res.cloudinary.com https://*.googleusercontent.com; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://api.cloudinary.com https://www.google.com https://*.workers.dev; frame-src https://*.firebaseapp.com https://accounts.google.com https://apis.google.com https://www.google.com https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/sw.js
  Cache-Control: no-cache
